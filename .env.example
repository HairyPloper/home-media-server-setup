# Compose project name
COMPOSE_PROJECT_NAME=home-media-server

# Host directory containing configs, media, torrents, and watch.
# Docker Desktop on Windows: D:/server
# Native Linux example: /srv/home-media-server
SERVER_ROOT=D:/server

# LinuxServer.io container identity and timezone
PUID=1000
PGID=1000
TZ=Etc/UTC

# Replace both values before starting the stack. Never commit your real .env.
TRANSMISSION_USER=replace-me
TRANSMISSION_PASS=replace-with-a-long-random-password
